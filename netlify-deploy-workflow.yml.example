name: Deploy to Netlify

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger Netlify deploy hook
        run: curl --fail --silent --show-error --request POST "$NETLIFY_BUILD_HOOK"
        env:          NETLIFY_BUILD_HOOK: https://api.netlify.com/build_hooks/6b0467d403326f5ff8be3b20
